{
  "appId": "com.acddirect.mocktestingsuite.notificationmanager",
  "productName": "Smart Alert Manager",
  "artifactName": "Smart-Alert-Manager-Setup-${version}.${ext}",
  "copyright": "Copyright © 2026 Shawn P. Bly",
  "directories": {
    "output": "dist-notification-manager"
  },
  "beforePack": "scripts/validate-apps-script-package.js",
  "publish": [
    {
      "provider": "github",
      "owner": "Blyshawnp",
      "repo": "sam-releases",
      "private": false,
      "publishAutoUpdate": true
    }
  ],
  "extraMetadata": {
    "name": "mock-testing-suite-notification-manager",
    "description": "Sam - Smart Alert Manager",
    "main": "src/notification-main.js"
  },
  "files": [
    "src/**/*",
    "assets/**/*",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "../frontend/build",
      "to": "frontend",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../backend/dist/backend.exe",
      "to": "backend/backend.exe"
    },
    {
      "from": "../backend/config/runtime_config.json",
      "to": "backend/config/runtime_config.json"
    },
    {
      "from": "../backend/config/apps-script-api-sam.json",
      "to": "backend/config/apps-script-api.json"
    },
    {
      "from": "../backend/defaults",
      "to": "backend/defaults",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../backend/drivers",
      "to": "backend/drivers",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "assets",
      "to": "assets",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/notification-taskbar.ico",
    "publisherName": "Shawn P. Bly"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": false,
    "installerIcon": "assets/notification-taskbar.ico",
    "uninstallerIcon": "assets/notification-taskbar.ico",
    "installerHeaderIcon": "assets/notification-taskbar.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Smart Alert Manager"
  }
}
