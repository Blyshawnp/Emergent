{
  "appId": "com.acddirect.mocktestingsuite.notificationmanager",
  "productName": "Sam",
  "artifactName": "Sam-Setup-${version}.${ext}",
  "copyright": "Copyright © 2026 Shawn P. Bly",
  "directories": {
    "output": "dist-notification-manager"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Blyshawnp",
      "repo": "sam-releases",
      "private": false,
      "publishAutoUpdate": true
    }
  ],
  "extraMetadata": {
    "name": "mock-testing-suite-notification-manager",
    "description": "Sam - Smart Alert Manager",
    "main": "src/notification-main.js"
  },
  "files": [
    "src/**/*",
    "assets/**/*",
    "node_modules/**/*"
  ],
  "extraResources": [
    {
      "from": "../frontend/build",
      "to": "frontend",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../backend/dist/backend.exe",
      "to": "backend/backend.exe"
    },
    {
      "from": "../backend/config",
      "to": "backend/config",
      "filter": [
        "**/runtime_config.json",
        "**/apps-script-api.json",
        "**/google-service-account.json",
        "**/service-account.json"
      ]
    },
    {
      "from": "..",
      "to": "backend/config",
      "filter": [
        "google-service-account.json"
      ]
    },
    {
      "from": "../backend/defaults",
      "to": "backend/defaults",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../backend/drivers",
      "to": "backend/drivers",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "assets",
      "to": "assets",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "assets/notification-taskbar.ico",
    "publisherName": "Shawn P. Bly"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": false,
    "installerIcon": "assets/notification-taskbar.ico",
    "uninstallerIcon": "assets/notification-taskbar.ico",
    "installerHeaderIcon": "assets/notification-taskbar.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Sam"
  }
}
