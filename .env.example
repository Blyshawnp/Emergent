# Google Sheets remains the production default until an explicit cutover.
MTS_DATA_PROVIDER=sheets
MTS_SHADOW_COMPARE=false
MTS_DUAL_WRITE_ENABLED=false

# Optional read-only diagnostics. These limits apply only when shadow comparison
# is explicitly enabled while the primary provider remains sheets.
MTS_SHADOW_MAX_WORKERS=2
MTS_SHADOW_MAX_QUEUED=4
MTS_SHADOW_IO_TIMEOUT_SECONDS=10
MTS_SHADOW_RETRY_LIMIT=0
MTS_SHADOW_LOG_INTERVAL_SECONDS=60
MTS_SHADOW_TELEMETRY_LIMIT=200

# Trusted FastAPI/backend process only. Never use REACT_APP_ or VITE_ prefixes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-secure-runtime-only
SUPABASE_TIMEOUT_SECONDS=10

# Existing Apps Script configuration remains external to source control.
MTS_APPS_SCRIPT_API_CONFIG=path-to-mts-config.json
SAM_APPS_SCRIPT_API_CONFIG=path-to-sam-config.json
